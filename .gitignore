.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.venv/
venv/
build/
dist/

# Local runtime config (main.yaml, seeded from configs/main.example.yaml on
# first run) and saved presets. Both carry osc.destinations, which may name
# a private host: only the example is tracked.
configs/*.yaml
!configs/main.example.yaml

# Locally cloned reference repos (not part of this project)
Realtime-beat-tracking/
madmom/

# Rust engine build output
engine/target/

# DSP parity goldens (~20 MB of .npy): regenerate with
# `uv run python tools/parity/make_goldens.py` (README.md + wire/ stay tracked)
testdata/golden/signals/
testdata/golden/cases/
testdata/golden/manifest.json
testdata/golden/filter_design_sos.npy
